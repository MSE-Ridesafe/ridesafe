    <string name="reconnect_grace_30s">30 Sekunden</string>
    <string name="reconnect_grace_1m">1 Minute</string>
    <string name="reconnect_grace_2m">2 Minuten</string>
    <string name="reconnect_grace_5m">5 Minuten</string>
    <string name="settings_min_ride_length_title">Mindestdauer einer Fahrt</string>
    <string name="settings_min_ride_length_detail_description">Aufzeichnungen, die kürzer sind, werden verworfen statt ins Fahrtenbuch aufgenommen — eine kurze Bluetooth-Verbindung oder das Umparken in der Einfahrt hinterlässt so keine Fahrt. Gemessen wird bis zum Verbindungsabbruch des Fahrzeugs; die Wartezeit danach zählt nicht mit.</string>
    <string name="min_ride_length_off">Aus (jede Fahrt behalten)</string>
