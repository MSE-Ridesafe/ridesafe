    <string name="settings_min_ride_length_title">Minimum ride length</string>
    <string name="settings_min_ride_length_detail_description">Recordings shorter than this are discarded instead of added to the logbook, so a brief Bluetooth connection or a move within the driveway leaves no ride behind. The length is measured up to the moment the vehicle disconnected, so the reconnect grace never counts towards it.</string>
